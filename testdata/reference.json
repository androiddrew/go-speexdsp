{
  "upstream": "SpeexDSP-1.2.1",
  "commit": "1b28a0f61bc31162979e1f26f3981fc3637095c8",
  "compiler": "gcc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0",
  "cflags": [
    "-DFLOATING_POINT",
    "-DUSE_SMALLFT",
    "-DEXPORT=",
    "-O2",
    "-ffp-contract=off"
  ],
  "fft_sizes": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    11,
    12,
    15,
    16,
    30,
    60,
    64,
    100,
    128,
    160,
    240,
    256,
    320,
    384,
    480,
    512,
    640,
    882,
    960,
    1024,
    2048
  ],
  "fft_vectors": 3,
  "generator": "go run ./tools/fixtures",
  "rate": 16000,
  "frame_fields": [
    "leak",
    "adapted",
    "prob",
    "agc_gain",
    "loudness",
    "vad"
  ],
  "scenarios": [
    {
      "name": "echo_only",
      "description": "agent voice through talkie's room (80 ms, -6 dB, 300 ms RT60, tanh speaker), no near end"
    },
    {
      "name": "echo_linear",
      "description": "agent voice through talkie's room with a linear speaker, no near end"
    },
    {
      "name": "double_talk",
      "description": "agent voice with the user talking over it from 3.0 s to 5.7 s and 6.2 s to 7.8 s"
    },
    {
      "name": "path_change",
      "description": "agent voice; at 5 s the room switches to 50 ms delay, -3 dB, 200 ms RT60"
    },
    {
      "name": "noise",
      "description": "user speech over -35 dBFS low-pass fan noise with a 120 Hz hum, no agent"
    },
    {
      "name": "level",
      "description": "user speech at -20 dB from 0.5 s to 5.6 s, then at full level from 6.0 s"
    },
    {
      "name": "edge",
      "description": "1 s of digital silence, 1 s of full-scale square (mic) and triangle (ref), 1 s of full-scale noise on both"
    }
  ],
  "runs": [
    {
      "name": "echo_only",
      "scenario": "echo_only",
      "pipeline": {
        "frame": 256,
        "filter": 4000,
        "denoise": true,
        "noise_suppress_db": -10,
        "echo_suppress_db": -40,
        "echo_suppress_active_db": -15,
        "agc": false,
        "agc_level": 8000,
        "link_echo": true,
        "vad": false
      }
    },
